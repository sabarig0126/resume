# Server-side Groq API configuration (REQUIRED for AI assistant backend)
# Never expose this key with a VITE_ prefix or in frontend source files.
GROQ_API_KEY=
# Optional Groq model override (defaults to openai/gpt-oss-120b with automatic fallback)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional Express server port (default: 3000)
# PORT=3000

# Optional canonical public HTTPS site URL (e.g. https://sabarivasan.dev)
# Used for server-rendered sitemap.xml, robots.txt, and canonical URLs.
# SITE_URL=
# VITE_SITE_URL=

# Optional consent-gated privacy-conscious analytics (activated ONLY after user consent)
# Configure either GA4 Measurement ID (G-XXXXXXXXXX) OR Plausible domain (example.com)
# VITE_GA_MEASUREMENT_ID=
# VITE_PLAUSIBLE_DOMAIN=

# Optional API base URL if deploying frontend separately from backend
# VITE_API_BASE_URL=